  "dependencies": {
    "@headlessui/react": "2.2.0",
    "@next/bundle-analyzer": "^16.2.6",
    "@tailwindcss/postcss": "^4.0.5",
    "body-scroll-lock": "^4.0.0-beta.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.4.24",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@svgr/webpack": "^8.0.1",
    "@types/node": "25.9.1",
    "@types/react": "^19.0.8",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "eslint": "^9.14.0",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "globals": "^15.12.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.0.0",
